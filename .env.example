# Base de datos PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tesorun?schema=public"

# PIN del admin: se pide via Basic Auth al entrar a /admin-teso
ADMIN_PASSWORD="tesorun2026"

# Meta mensual de recaudacion en pesos (usuario/cualquiera, la contrasena debe coincidir con el PIN)
META_MENSUAL_PESOS=2000

# Clave publica de Giphy para el buscador de GIFs del muro (se expone al navegador)
# https://developers.giphy.com/
NEXT_PUBLIC_GIPHY_API_KEY="tu_clave_de_giphy_aca"

# Cloudinary (unsigned upload) para subir imagenes y notas de voz del muro
# 1) Crea un "Upload preset" tipo Unsigned en: Settings > Upload > Upload presets
# 2) Cloud Name aparece en el Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu_cloud_name_aca"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="tu_unsigned_preset_aca"

# Credenciales SECRETAS del SDK de Node (solo server) para borrar archivos de
# Cloudinary cuando el admin elimina un comentario (liberar espacio).
# CLOUDINARY_CLOUD_NAME debe coincidir con NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME.
CLOUDINARY_CLOUD_NAME="tu_cloud_name_aca"
CLOUDINARY_API_KEY="tu_api_key_aca"
CLOUDINARY_API_SECRET="tu_api_secret_aca"