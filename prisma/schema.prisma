generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Alumno {
  id             String         @id @default(cuid())
  nombre         String
  avatarUrl      String?        @db.Text // Base64 largo permitido (foto subida por el admin)
  semanasPagadas Int            @default(0)
  rachaActual    Int            @default(0)
  mejorRacha     Int            @default(0)
  ultimoPago     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  transacciones  Transaccion[]
  comentarios    Comentario[]
}

model Transaccion {
  id          String   @id @default(cuid())
  monto       Float
  tipo        String // "INGRESO" o "GASTO"
  descripcion String
  notaAdmin   String? // Nota opcional al registrar pago
  fecha       DateTime @default(now())
  alumnoId    String?
  alumno      Alumno?  @relation(fields: [alumnoId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([tipo])
}

model Comentario {
  id        String   @id @default(cuid())
  alias     String // Apodo anónimo (ej. "Monito Tacaño")
  contenido String?  @default("") @db.Text // "" si el comentario es solo GIF/imagen/audio
  gifUrl    String? // GIF del buscador de Giphy o catálogo permitido
  imageUrl  String? @db.Text // URL de imagen (Cloudinary) o catálogo permitido
  audioUrl  String? @db.Text // URL de audio (Cloudinary)
  fecha     DateTime @default(now())
  alumnoId  String? // Legado: comentarios antiguos atados a un alumno
  alumno    Alumno?  @relation(fields: [alumnoId], references: [id], onDelete: SetNull)
  reacciones Reaccion[]

  @@index([fecha])
}

model Reaccion {
  id           String    @id @default(cuid())
  emoji        String // Cualquier emoji UTF-8 (validado en servidor)
  votantes     String[] // deviceIds que reaccionaron
  comentarioId String
  comentario   Comentario @relation(fields: [comentarioId], references: [id], onDelete: Cascade)

  @@unique([comentarioId, emoji])
}

model Anuncio {
  id      String   @id @default(cuid())
  mensaje String
  activo  Boolean  @default(true)
  fecha   DateTime @default(now())
}

model Encuesta {
  id        String   @id @default(cuid())
  pregunta  String
  esAdmin   Boolean  @default(false)
  activa    Boolean  @default(true) // false = cerrada, solo se muestran resultados
  creadorId String? // deviceId del creador (encuestas públicas)
  fecha     DateTime @default(now())
  opciones  Opcion[]

  @@index([fecha])
}

model Opcion {
  id         String   @id @default(cuid())
  texto      String
  votos      Int      @default(0)
  votantes   String[] // deviceIds que ya votaron (evita multi-voto)
  encuestaId String
  encuesta   Encuesta @relation(fields: [encuestaId], references: [id], onDelete: Cascade)

  @@index([encuestaId])
}

model Sugerencia {
  id      String   @id @default(cuid())
  mensaje String
  leida   Boolean  @default(false)
  fecha   DateTime @default(now())

  @@index([fecha])
}

// Fila unica (id = 1) con la fecha de inicio oficial de recoleccion.
model Configuracion {
  id                  Int      @id @default(1)
  fechaInicio         DateTime
  maxEncuestasDiarias Int      @default(5) // Limite global anti-spam del muro
}